{
    "window.zoomLevel": 1,
    "editor.fontSize": 22,
    "editor.hover.enabled": true,
    "workbench.startupEditor": "none",
    "explorer.compactFolders": false,
    "terminal.integrated.fontSize": 20,
    "editor.rulers": [
        80,
        120
    ],
    "workbench.colorTheme": "Omni",
    "workbench.iconTheme": "material-icon-theme",
    "code-runner.executorMap": {
        "python": "clear ; python -u"
    },
    "code-runner.runInTerminal": true,
    "code-runner.ignoreSelection": true,
    "editor.fontFamily": "jetBrains mono, 'Dank Mono', 'Source Code Pro', 'Fira Code', Menlo, 'Inconsolata', 'Droid Sans Mono', 'DejaVu Sans Mono', 'Ubuntu Mono', 'Courier New', Courier, Monaco, monospace",
    "terminal.integrated.fontFamily": "",
    "[python]": {
        "editor.defaultFormatter": "ms-python.python",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll": "always",
            "source.fixAll.unusedImports": "always",
            "source.organizeImports": "always"
        }
    },
    "python.languageServer": "Pylance",
    "python.formatting.autopep8Args": [
        "--indent-size=4",
        "--max-line-length=80"
    ],
    "python.linting.flake8Args": [],
    "python.defaultInterpreterPath": "ambiente_virtual/Scripts/python.exe",
    "python.linting.flake8Path": "C:\\Users\\lucia\\Documents\\curso_python\\venv\\Scripts\\flake8.exe",
    "python.linting.mypyPath": "C:\\Users\\lucia\\Documents\\curso_python\\venv\\Scripts\\mypy.exe",
    "python.linting.flake8Enabled": true,
    "python.linting.mypyEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "python.analysis.diagnosticSeverityOverrides": {},
    "python.analysis.typeCheckingMode": "basic",
    "cSpell.enabled": false,
    "python.analysis.autoImportCompletions": true
}